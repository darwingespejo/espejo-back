# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL_CA=

# API Authentication (use separate random values of at least 32 characters)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Comma-separated frontend origins; leave blank for local development
CORS_ALLOWED_ORIGINS=

# Set true only while running database migrations in a trusted environment.
MIGRATION_ENABLED=false
